{
  "expo": {
    "name": "Focus",
    "slug": "eightedge-focus",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "eightedge-focus",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eightedge.focus"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A2332"
      },
      "package": "com.eightedge.focus"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ]
  }
}
