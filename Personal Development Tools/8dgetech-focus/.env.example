# Free Supabase project: https://supabase.com/dashboard → New project
# Auth → Providers → Email: enable Email provider
#   - "Confirm email" optional (if on, users confirm before first sign-in)
# Auth → URL Configuration → Site URL + Redirect URLs add:
#   8dgetech-focus://**
#   http://localhost:8081/**
#   https://YOUR_HOSTINGER_DOMAIN/en/portfolio/**
# Auth → Emails → SMTP Settings (recommended) so reset/confirm emails deliver
# Then run supabase/schema.sql in SQL Editor.
# Includes Pulse tables + drift_sessions for Drift admin/sync.
# To be admin: Table Editor → profiles → set your row role = admin

# Project URL only — NO /rest/v1/ suffix
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Publishable / anon key (not the secret key)
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
