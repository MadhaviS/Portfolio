# Free Supabase project: https://supabase.com/dashboard → New project
# Auth → Providers → Email: enable "Confirm email" + Email OTP
# Auth → URL Configuration → Redirect URLs add:
#   8dgetech-focus://**
#   http://localhost:8081/**
#   https://YOUR_HOSTINGER_DOMAIN/**
# Then run supabase/schema.sql in SQL Editor.
# To be admin: Table Editor → profiles → set your row role = admin

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
