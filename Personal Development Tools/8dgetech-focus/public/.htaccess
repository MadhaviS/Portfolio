# Hostinger / LiteSpeed — Expo static export under /en/portfolio
# Routes are exported as *.html (pomodoro.html). Clean URLs need a rewrite.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /en/portfolio/

  # Keep real files and directories as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # /pomodoro → pomodoro.html (and same for admin, home, sign-in, …)
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # Absolute fallback if REQUEST_FILENAME mapping differs on LiteSpeed
  RewriteCond %{DOCUMENT_ROOT}/en/portfolio/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # SPA / client routes → index
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
</IfModule>
